NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://acriland:acriland@localhost:5432/acriland?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ACRILAND Fleet <fleet@acriland.local>
BOOTSTRAP_ORG_NAME=ACRILAND LTD
BOOTSTRAP_ORG_SLUG=acriland
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Secure file storage (use a persistent volume in production)
FILE_STORAGE_ROOT=./data/uploads
MAX_PROFILE_PHOTO_MB=5
