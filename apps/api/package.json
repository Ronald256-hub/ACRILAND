{
  "name": "@acriland/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name phase1_foundation",
    "bootstrap": "tsx scripts/bootstrap-admin.ts",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "17.2.1",
    "express": "5.1.0",
    "express-rate-limit": "8.6.2",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "nodemailer": "7.0.13",
    "zod": "3.25.76",
    "multer": "2.2.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.17.1",
    "@types/nodemailer": "6.4.17",
    "prisma": "6.19.3",
    "tsx": "4.20.3",
    "typescript": "5.9.2",
    "@types/multer": "2.0.0"
  }
}
