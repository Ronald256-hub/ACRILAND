generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
  INVITED
}

enum DriverStatus {
  ACTIVE
  OFF_DUTY
  LEAVE
  SUSPENDED
  LICENCE_EXPIRED
  INACTIVE
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  ASSIGNED
  ON_TRIP
  PARKED
  SERVICE_DUE
  SERVICE_OVERDUE
  UNDER_INSPECTION
  UNDER_MAINTENANCE
  BREAKDOWN
  ACCIDENT
  GROUNDED
  OUT_OF_SERVICE
  DISPOSED
}

enum FuelType {
  DIESEL
  PETROL
  ELECTRIC
  HYBRID
  LPG
  CNG
  OTHER
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
  AMT
  CVT
  OTHER
}

enum AssignmentType {
  PRIMARY
  TEMPORARY
  TRIP
}

enum AssignmentStatus {
  ACTIVE
  ENDED
  CANCELLED
}

enum TripStatus {
  REQUESTED
  APPROVED
  REJECTED
  ALLOCATED
  PRE_TRIP_INSPECTION
  READY_TO_DEPART
  ACTIVE
  RETURNED
  POST_TRIP_INSPECTION
  CLOSED
  CANCELLED
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

enum InspectionType {
  PRE_TRIP
  POST_TRIP
  DAILY
  WEEKLY
  WORKSHOP
  SAFETY
  HANDOVER
}

enum InspectionItemResult {
  PASS
  ATTENTION_REQUIRED
  FAIL
  NOT_APPLICABLE
}

enum InspectionStatus {
  IN_PROGRESS
  PASSED
  FAILED
  COMPLETED_WITH_ATTENTION
}

enum MaintenancePriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum MaintenanceStatus {
  OPEN
  DIAGNOSIS
  AWAITING_APPROVAL
  APPROVED
  IN_PROGRESS
  QC
  READY_FOR_RELEASE
  CLOSED
  CANCELLED
}

enum FuelRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  ISSUED
  CANCELLED
}

enum ComplianceType {
  INSURANCE
  ROAD_LICENCE
  FITNESS
  THIRD_PARTY
  TAX
  WARRANTY
  OTHER
}

enum TyreStatus {
  IN_STOCK
  FITTED
  REPAIR
  SCRAPPED
}

enum IncidentType {
  ACCIDENT
  BREAKDOWN
  DAMAGE
  THEFT
  SAFETY
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  ACTION_REQUIRED
  CLOSED
}

enum StockMovementType {
  RECEIPT
  ISSUE
  ADJUSTMENT
  RETURN
}

enum ProcurementStatus {
  DRAFT
  REQUESTED
  APPROVED
  REJECTED
  ORDERED
  RECEIVED
  CANCELLED
}

enum MaintenancePlanStatus {
  ACTIVE
  PAUSED
  RETIRED
}

enum OperationalAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum OperationalAlertStatus {
  OPEN
  ACKNOWLEDGED
  CLOSED
}

enum DispatchStatus {
  PLANNED
  READY
  DISPATCHED
  COMPLETED
  CANCELLED
  BLOCKED
}

enum GeofenceShape {
  CIRCLE
  POLYGON
}

enum GeofencePolicy {
  MONITOR
  ALLOWED
  RESTRICTED
}

enum GeofenceEventType {
  ENTRY
  EXIT
}

enum SafetyEventType {
  SPEEDING
  GEOFENCE_BREACH
  INCIDENT
  INSPECTION_FAILURE
  AFTER_HOURS
  OTHER
}

enum VendorStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum CostCategory {
  ACQUISITION
  FUEL
  MAINTENANCE
  TYRE
  INSURANCE
  LICENCE
  TAX
  TOLL
  PARKING
  ACCIDENT
  OTHER
}

enum DisposalStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

model Organization {
  id                  String                 @id @default(uuid()) @db.Uuid
  name                String
  slug                String                 @unique
  currency            String                 @default("UGX")
  timezone            String                 @default("Africa/Kampala")
  isActive            Boolean                @default(true)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  branches            Branch[]
  departments         Department[]
  users               User[]
  roles               Role[]
  drivers             Driver[]
  vehicles            Vehicle[]
  auditLogs           AuditLog[]
  loginEvents         LoginEvent[]
  assignments         VehicleAssignment[]
  trips               Trip[]
  inspectionTemplates InspectionTemplate[]
  inspections         VehicleInspection[]
  maintenanceOrders   MaintenanceWorkOrder[]
  fuelTransactions    FuelTransaction[]
  complianceDocuments ComplianceDocument[]
}

model Branch {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  code           String
  name           String
  address        String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  departments    Department[]
  users          User[]
  drivers        Driver[]
  vehicles       Vehicle[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
}

model Department {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  branchId       String?      @db.Uuid
  code           String
  name           String
  costCentre     String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  users          User[]
  drivers        Driver[]
  vehicles       Vehicle[]
  trips          Trip[]

  @@unique([organizationId, code])
  @@index([organizationId, branchId])
}

model User {
  id                         String                 @id @default(uuid()) @db.Uuid
  organizationId             String                 @db.Uuid
  branchId                   String?                @db.Uuid
  departmentId               String?                @db.Uuid
  email                      String
  fullName                   String
  phone                      String?
  passwordHash               String
  status                     UserStatus             @default(ACTIVE)
  mustChangePassword         Boolean                @default(true)
  failedLoginCount           Int                    @default(0)
  lockedUntil                DateTime?
  lastLoginAt                DateTime?
  archivedAt                 DateTime?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  organization               Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch                     Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department                 Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  roles                      UserRole[]
  sessions                   Session[]
  passwordResetTokens        PasswordResetToken[]
  driver                     Driver?
  assignmentsCreated         VehicleAssignment[]    @relation("AssignmentCreatedBy")
  assignmentsEnded           VehicleAssignment[]    @relation("AssignmentEndedBy")
  tripsRequested             Trip[]                 @relation("TripRequester")
  tripsApproved              Trip[]                 @relation("TripApprover")
  tripApprovals              TripApproval[]         @relation("TripApprovalApprover")
  inspectionTemplatesCreated InspectionTemplate[]   @relation("InspectionTemplateCreator")
  inspectionsPerformed       VehicleInspection[]    @relation("InspectionPerformer")
  maintenanceOpened          MaintenanceWorkOrder[] @relation("MaintenanceOpenedBy")
  maintenanceApproved        MaintenanceWorkOrder[] @relation("MaintenanceApprovedBy")
  maintenanceReleased        MaintenanceWorkOrder[] @relation("MaintenanceReleasedBy")
  fuelRequested              FuelTransaction[]      @relation("FuelRequestedBy")
  fuelApproved               FuelTransaction[]      @relation("FuelApprovedBy")
  complianceCreated          ComplianceDocument[]   @relation("ComplianceCreatedBy")

  @@unique([organizationId, email])
  @@index([organizationId, status])
}

model Role {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  description    String?
  isSystem       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  users          UserRole[]

  @@unique([organizationId, name])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Session {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  refreshTokenHash String   @unique
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())
  lastUsedAt       DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model LoginEvent {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  userId         String?       @db.Uuid
  email          String
  success        Boolean
  reason         String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([email, createdAt])
}

model Driver {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @db.Uuid
  branchId         String?           @db.Uuid
  departmentId     String?           @db.Uuid
  userId           String?           @unique @db.Uuid
  employeeNumber   String
  fullName         String
  phone            String?
  email            String?
  nationalIdRef    String?
  licenceNumber    String
  licenceClass     String
  licenceIssueDate DateTime?
  licenceExpiry    DateTime
  emergencyContact String?
  status           DriverStatus      @default(ACTIVE)
  photoUrl         String?
  notes            String?
  archivedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch           Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department       Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  licences         DriverLicence[]
  assignments      VehicleAssignment[]
  trips            Trip[]
  inspections      VehicleInspection[]
  fuelTransactions FuelTransaction[]

  @@unique([organizationId, employeeNumber])
  @@unique([organizationId, licenceNumber])
  @@index([organizationId, status])
  @@index([organizationId, licenceExpiry])
}

model DriverLicence {
  id          String   @id @default(uuid()) @db.Uuid
  driverId    String   @db.Uuid
  number      String
  class       String
  issueDate   DateTime?
  expiryDate  DateTime
  documentUrl String?
  createdAt   DateTime @default(now())
  driver      Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, expiryDate])
}

model Vehicle {
  id                  String                 @id @default(uuid()) @db.Uuid
  organizationId      String                 @db.Uuid
  branchId            String?                @db.Uuid
  departmentId        String?                @db.Uuid
  registrationNumber  String
  fleetNumber         String?
  vin                 String
  engineNumber        String?
  make                String
  model               String
  variant             String?
  category            String
  bodyType            String?
  manufacturingYear   Int
  registrationYear    Int?
  fuelType            FuelType
  transmission        TransmissionType?
  engineCapacityCc    Int?
  tankCapacityLitres  Decimal?               @db.Decimal(10, 2)
  grossWeightKg       Decimal?               @db.Decimal(12, 2)
  colour              String?
  costCentre          String?
  acquisitionMethod   String?
  ownershipType       String?
  purchaseDate        DateTime?
  purchasePrice       Decimal?               @db.Decimal(18, 2)
  supplier            String?
  warrantyStart       DateTime?
  warrantyEnd         DateTime?
  warrantyMileageKm   Int?
  initialOdometerKm   Int                     @default(0)
  currentOdometerKm   Int                     @default(0)
  currentLocation     String?
  imageUrl            String?
  notes               String?
  status              VehicleStatus           @default(AVAILABLE)
  lastServiceAt       DateTime?
  nextServiceDueAt    DateTime?
  nextServiceDueKm    Int?
  serviceIntervalKm   Int?
  archivedAt          DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch              Branch?                 @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department          Department?             @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignments         VehicleAssignment[]
  trips               Trip[]
  inspections         VehicleInspection[]
  maintenanceOrders   MaintenanceWorkOrder[]
  fuelTransactions    FuelTransaction[]
  complianceDocuments ComplianceDocument[]

  @@unique([organizationId, registrationNumber])
  @@unique([organizationId, vin])
  @@index([organizationId, status])
  @@index([organizationId, branchId])
  @@index([organizationId, currentOdometerKm])
}

model VehicleAssignment {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @db.Uuid
  vehicleId         String           @db.Uuid
  driverId          String           @db.Uuid
  assignmentType    AssignmentType
  status            AssignmentStatus @default(ACTIVE)
  purpose           String?
  startAt           DateTime         @default(now())
  endAt             DateTime?
  assignedByUserId  String           @db.Uuid
  endedByUserId     String?          @db.Uuid
  handoverConfirmed Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vehicle           Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver            Driver           @relation(fields: [driverId], references: [id], onDelete: Restrict)
  assignedBy        User             @relation("AssignmentCreatedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  endedBy           User?            @relation("AssignmentEndedBy", fields: [endedByUserId], references: [id], onDelete: Restrict)
  trips             Trip[]

  @@index([organizationId, status])
  @@index([vehicleId, status])
  @@index([driverId, status])
}

model Trip {
  id                  String             @id @default(uuid()) @db.Uuid
  organizationId      String             @db.Uuid
  tripNumber          String
  vehicleId           String?            @db.Uuid
  driverId            String?            @db.Uuid
  assignmentId        String?            @db.Uuid
  requesterUserId     String             @db.Uuid
  departmentId        String?            @db.Uuid
  purpose             String
  origin              String
  destination         String
  intermediateStops   Json?
  requestedDeparture  DateTime
  expectedReturn      DateTime
  actualDeparture     DateTime?
  actualReturn        DateTime?
  startingOdometerKm  Int?
  endingOdometerKm    Int?
  distanceKm          Int?
  startingFuelPercent Int?
  endingFuelPercent   Int?
  passengerCount      Int                @default(0)
  cargoInfo           String?
  status              TripStatus         @default(REQUESTED)
  approvedByUserId    String?            @db.Uuid
  approvedAt          DateTime?
  rejectionReason     String?
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vehicle             Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver              Driver?            @relation(fields: [driverId], references: [id], onDelete: Restrict)
  assignment          VehicleAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  requester           User               @relation("TripRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  approvedBy          User?              @relation("TripApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  department          Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  approvals           TripApproval[]
  inspections         VehicleInspection[]
  fuelTransactions    FuelTransaction[]

  @@unique([organizationId, tripNumber])
  @@index([organizationId, status, requestedDeparture])
  @@index([vehicleId, status])
  @@index([driverId, status])
  @@index([requesterUserId, status])
}

model TripApproval {
  id             String           @id @default(uuid()) @db.Uuid
  tripId         String           @db.Uuid
  stage          String           @default("FLEET_MANAGER")
  decision       ApprovalDecision @default(PENDING)
  approverUserId String?          @db.Uuid
  comments       String?
  decidedAt      DateTime?
  createdAt      DateTime         @default(now())
  trip           Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  approver       User?            @relation("TripApprovalApprover", fields: [approverUserId], references: [id], onDelete: Restrict)

  @@index([tripId, decision])
}

model InspectionTemplate {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @db.Uuid
  name            String
  type            InspectionType
  description     String?
  isActive        Boolean        @default(true)
  createdByUserId String?        @db.Uuid
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy       User?          @relation("InspectionTemplateCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  items           InspectionTemplateItem[]
  inspections     VehicleInspection[]

  @@unique([organizationId, name, type])
  @@index([organizationId, type, isActive])
}

model InspectionTemplateItem {
  id          String             @id @default(uuid()) @db.Uuid
  templateId  String             @db.Uuid
  code        String
  label       String
  description String?
  isCritical  Boolean            @default(false)
  sortOrder   Int                @default(0)
  template    InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  results     InspectionResult[]

  @@unique([templateId, code])
  @@index([templateId, sortOrder])
}

model VehicleInspection {
  id                String              @id @default(uuid()) @db.Uuid
  organizationId    String              @db.Uuid
  vehicleId         String              @db.Uuid
  driverId          String?             @db.Uuid
  tripId            String?             @db.Uuid
  templateId        String?             @db.Uuid
  type              InspectionType
  odometerKm        Int
  status            InspectionStatus    @default(IN_PROGRESS)
  notes             String?
  performedByUserId String              @db.Uuid
  completedAt       DateTime?
  createdAt         DateTime            @default(now())
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vehicle           Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver            Driver?             @relation(fields: [driverId], references: [id], onDelete: SetNull)
  trip              Trip?               @relation(fields: [tripId], references: [id], onDelete: SetNull)
  template          InspectionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  performedBy       User                @relation("InspectionPerformer", fields: [performedByUserId], references: [id], onDelete: Restrict)
  results           InspectionResult[]

  @@index([organizationId, type, createdAt])
  @@index([vehicleId, createdAt])
  @@index([tripId, type])
}

model InspectionResult {
  id             String                 @id @default(uuid()) @db.Uuid
  inspectionId   String                 @db.Uuid
  templateItemId String                 @db.Uuid
  labelSnapshot  String
  result         InspectionItemResult
  isCritical     Boolean                @default(false)
  comment        String?
  createdAt      DateTime               @default(now())
  inspection     VehicleInspection      @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  templateItem   InspectionTemplateItem @relation(fields: [templateItemId], references: [id], onDelete: Restrict)

  @@unique([inspectionId, templateItemId])
  @@index([inspectionId, result])
}

model MaintenanceWorkOrder {
  id               String              @id @default(uuid()) @db.Uuid
  organizationId   String              @db.Uuid
  workOrderNumber  String
  vehicleId        String              @db.Uuid
  openedByUserId   String              @db.Uuid
  priority         MaintenancePriority @default(NORMAL)
  status           MaintenanceStatus   @default(OPEN)
  category         String
  title            String
  description      String
  odometerKm       Int
  diagnosis        String?
  vendor           String?
  estimatedCost    Decimal?            @db.Decimal(18, 2)
  labourCost       Decimal?            @db.Decimal(18, 2)
  partsCost        Decimal?            @db.Decimal(18, 2)
  totalCost        Decimal?            @db.Decimal(18, 2)
  approvedByUserId String?             @db.Uuid
  approvedAt       DateTime?
  workPerformed    String?
  qcNotes          String?
  releasedByUserId String?             @db.Uuid
  releasedAt       DateTime?
  openedAt         DateTime            @default(now())
  completedAt      DateTime?
  downtimeStart    DateTime?
  downtimeEnd      DateTime?
  nextServiceDueAt DateTime?
  nextServiceDueKm Int?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vehicle          Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  openedBy         User                @relation("MaintenanceOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict)
  approvedBy       User?               @relation("MaintenanceApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  releasedBy       User?               @relation("MaintenanceReleasedBy", fields: [releasedByUserId], references: [id], onDelete: Restrict)

  @@unique([organizationId, workOrderNumber])
  @@index([organizationId, status, priority])
  @@index([vehicleId, openedAt])
}

model FuelTransaction {
  id                String            @id @default(uuid()) @db.Uuid
  organizationId    String            @db.Uuid
  requestNumber     String
  vehicleId         String            @db.Uuid
  driverId          String?           @db.Uuid
  tripId            String?           @db.Uuid
  requestedByUserId String            @db.Uuid
  approvedByUserId  String?           @db.Uuid
  status            FuelRequestStatus @default(REQUESTED)
  fuelType          FuelType
  requestedLitres   Decimal           @db.Decimal(10, 2)
  issuedLitres      Decimal?          @db.Decimal(10, 2)
  unitPrice         Decimal?          @db.Decimal(18, 2)
  totalCost         Decimal?          @db.Decimal(18, 2)
  station           String?
  odometerKm        Int
  receiptNumber     String?
  notes             String?
  rejectionReason   String?
  requestedAt       DateTime          @default(now())
  approvedAt        DateTime?
  issuedAt          DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vehicle           Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver            Driver?           @relation(fields: [driverId], references: [id], onDelete: SetNull)
  trip              Trip?             @relation(fields: [tripId], references: [id], onDelete: SetNull)
  requestedBy       User              @relation("FuelRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  approvedBy        User?             @relation("FuelApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)

  @@unique([organizationId, requestNumber])
  @@index([organizationId, status, requestedAt])
  @@index([vehicleId, issuedAt])
